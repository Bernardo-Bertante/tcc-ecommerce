/.github/skills/
.env

# Gradle/Java build artifacts
**/.gradle/
**/build/
**/out/
**/target/

# Local runtime files
*.log
*.tmp

# Python local environment/cache
.venv/
**/__pycache__/
.pytest_cache/
.mypy_cache/

# Node local dependencies
**/node_modules/

# IDE/OS noise
.idea/
*.iml
.DS_Store

# Benchmark result artifacts
benchmark/results/**/*_run*.json
!benchmark/results/**/*-summary.json
!benchmark/results/**/*_cloudwatch.jsonl
!benchmark/results/**/*.csv
benchmark/results/_downloads/
benchmark/results/aws**

# Local runner envs and keys (do NOT ignore example envs like fargate-aws.env.example)
aws-runner.env
benchmark/run/*.env
*.pem


# Saida de build do Eclipse/Gradle (nunca versionar)
order-processor/*/bin/

# Saídas brutas grandes do k6 e de profiling (ver DADOS_GRANDES.md)
analysis/**/*-raw.json
analysis/**/*.k6.csv
analysis/**/*.k6.csv.gz
analysis/**/k6_raw.json.gz
analysis/**/*.collapsed
analysis/**/*.jfr
analysis/**/codelist*.txt
analysis/**/gc_raw/

# Backups de edição e metadados efêmeros do runner
*.bak
*.bak-*
benchmark/aws-runner-meta.env
benchmark/results/runner-meta.env
