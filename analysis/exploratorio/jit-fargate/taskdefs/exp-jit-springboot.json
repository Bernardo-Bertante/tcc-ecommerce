{
  "family": "exp-jit-springboot",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::776648109551:role/exp-jit-task-exec-role",
  "taskRoleArn": "arn:aws:iam::776648109551:role/exp-jit-task-role",
  "tags": [
    {
      "key": "Projeto",
      "value": "tcc-exp-jit"
    }
  ],
  "containerDefinitions": [
    {
      "name": "order-service-springboot",
      "image": "776648109551.dkr.ecr.us-east-1.amazonaws.com/order-service-springboot@sha256:276548dd7956b91122dbb641d50030c0d81d59a3e1bef54357ba965b77f77c68",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8081,
          "hostPort": 8081,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "JAVA_OPTS_APPEND",
          "value": "-XX:+PrintCompilation"
        },
        {
          "name": "SERVER_PORT",
          "value": "8081"
        },
        {
          "name": "SPRING_FLYWAY_URL",
          "value": "jdbc:postgresql://exp-jit-postgres.ck1kkwa6og4s.us-east-1.rds.amazonaws.com:5432/orderdb"
        },
        {
          "name": "SPRING_FLYWAY_USER",
          "value": "orderuser"
        },
        {
          "name": "SPRING_R2DBC_POOL_INITIAL_SIZE",
          "value": "15"
        },
        {
          "name": "SPRING_R2DBC_POOL_MAX_SIZE",
          "value": "40"
        },
        {
          "name": "SPRING_R2DBC_URL",
          "value": "r2dbc:postgresql://exp-jit-postgres.ck1kkwa6og4s.us-east-1.rds.amazonaws.com:5432/orderdb?sslMode=REQUIRE"
        },
        {
          "name": "SPRING_R2DBC_USERNAME",
          "value": "orderuser"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "exp-jit-springboot",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "mode": "non-blocking",
          "max-buffer-size": "25m"
        }
      },
      "systemControls": [],
      "secrets": [
        {
          "name": "SPRING_R2DBC_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:776648109551:secret:exp-jit-db-5krZUL"
        },
        {
          "name": "SPRING_FLYWAY_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:us-east-1:776648109551:secret:exp-jit-db-5krZUL"
        }
      ]
    }
  ]
}
