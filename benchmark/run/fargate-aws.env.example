# Example AWS Fargate runner config for Order Service.
# Copy values from the CloudFormation outputs printed by deploy-order-service-stack.sh.

: "${ENVIRONMENT:=aws}"
: "${RUN_ID:=official-clean-8vcpu16gb-rds-t3medium-f1-30-quarkus-native-summaryonly-$(date +%Y%m%d-%H%M%S)}"
: "${SMOKE:=true}"
: "${REPETITIONS:=1}"
: "${VERSION_REST_SECONDS:=0}"
: "${K6_OUTPUT_MODE:=summary-only}"
: "${ABORT_ON_FAIL:=false}"
: "${STARTUP_TIMEOUT_SECONDS:=300}"
: "${COLLECT_CONTAINER_STATS:=false}"
: "${MEASURE_STARTUP:=false}"
: "${FARGATE_SCENARIOS:=f1_low_load f2_high_load f2s_summary_only f3_burst_autoscaling}"

# Official scenario rates.
: "${F1_RATE:=30}"
: "${F2_WARMUP_RATE:=30}"
: "${F2_RATE:=60}"
: "${F2S_RATE:=60}"
: "${F3_BASELINE_RATE:=30}"
: "${F3_AVERAGE_RATE:=225}"
: "${F3_STRESS_RATE:=300}"
: "${F3S_RATE:=300}"

# Keep the version names canonical and match the ALB output URLs.
: "${FARGATE_VERSIONS:=quarkus-native|http://REPLACE_ALB_DNS:8081 quarkus-jvm|http://REPLACE_ALB_DNS:8082 springboot|http://REPLACE_ALB_DNS:8083}"

# Optional: reset database before each version block to avoid summary/results bias.
# : "${RESET_DB_COMMAND:=infrastructure/aws/scripts/reset-order-service-db.sh --profile YOUR_PROFILE --region YOUR_REGION --stack-name order-service-benchmark}"

# Health paths match the application frameworks and ALB target group checks.
: "${HEALTH_PATH_QUARKUS_NATIVE:=/q/health}"
: "${HEALTH_PATH_QUARKUS_JVM:=/q/health}"
: "${HEALTH_PATH_SPRINGBOOT:=/actuator/health}"