# Local preliminary run for overnight F1/F2 validation.
# Each assignment keeps an existing environment override when one is provided.

: "${SMOKE:=false}"
: "${FARGATE_SCENARIOS:=f1_low_load f2_high_load}"
: "${REPETITIONS:=5}"
: "${VERSION_REST_SECONDS:=600}"

# Output policy: F1 keeps raw JSON in every repetition (~100 MB each).
# F2 raw JSON is large (~3 GB each); when this flag is true, raw JSON is
# emitted only on repetition 1 of each version (3 raw files total, ~10 GB).
# Subsequent F2 repetitions still produce a small *-summary.json artifact.
: "${F2_RAW_FIRST_REP_ONLY:=true}"

# Hard gate: refuse to start the run if free disk under results_dir is below
# this threshold (in GB). 50 GB is enough for the configuration above.
: "${MIN_FREE_DISK_GB:=50}"

: "${COLLECT_CONTAINER_STATS:=true}"
: "${STATS_INTERVAL_SECONDS:=5}"
: "${MEASURE_STARTUP:=true}"
: "${STARTUP_TIMEOUT_SECONDS:=180}"

: "${COMPOSE_FILE:=infrastructure/docker-compose.benchmark.yml}"
: "${COMPOSE_PROJECT:=tcc-order-service-benchmark}"
